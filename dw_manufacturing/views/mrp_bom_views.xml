<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_dw" model="ir.ui.view">
        <field name="name">mrp.bom.form.dw</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="Metal Fabrication" name="dw_fabrication">
                    <group>
                        <group string="Origin">
                            <field name="dw_opening_id" readonly="1"/>
                            <field name="dw_project_id" readonly="1"/>
                            <field name="dw_partner_id" readonly="1"/>
                        </group>
                        <group string="Control">
                            <field name="dw_drawing_revision_id"/>
                            <field name="dw_is_item_specific" readonly="1"/>
                            <field name="dw_is_reference"/>
                        </group>
                    </group>
                    <div>
                        <button name="action_dw_copy_for_item" type="object"
                                class="btn-secondary"
                                string="Duplicate for a Manufacturing Item"
                                invisible="not dw_is_reference"/>
                    </div>
                    <div class="text-muted">
                        A reference bill of materials is never consumed directly: duplicate it so
                        each manufacturing order keeps its own frozen copy and earlier orders are
                        never affected by a later change.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_search_dw" model="ir.ui.view">
        <field name="name">mrp.bom.search.dw</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="dw_opening_id"/>
                <field name="dw_project_id"/>
            </field>
        </field>
    </record>
</odoo>
