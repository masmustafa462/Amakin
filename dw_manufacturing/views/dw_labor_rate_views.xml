<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dw_labor_rate_view_list" model="ir.ui.view">
        <field name="name">dw.labor.rate.list</field>
        <field name="model">dw.labor.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="employee_category"/>
                <field name="workcenter_id"/>
                <field name="operation_type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="hourly_cost"/>
                <field name="overtime_multiplier" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dw_labor_rate_view_search" model="ir.ui.view">
        <field name="name">dw.labor.rate.search</field>
        <field name="model">dw.labor.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="workcenter_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Work Center" name="group_wc" context="{'group_by': 'workcenter_id'}"/>
                    <filter string="Category" name="group_cat" context="{'group_by': 'employee_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dw_labor_rate_action" model="ir.actions.act_window">
        <field name="name">Labour Rates</field>
        <field name="res_model">dw.labor.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="dw_overhead_rule_view_list" model="ir.ui.view">
        <field name="name">dw.overhead.rule.list</field>
        <field name="model">dw.overhead.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="family_id"/>
                <field name="method"/>
                <field name="rate"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dw_overhead_rule_action" model="ir.actions.act_window">
        <field name="name">Overhead Rules</field>
        <field name="res_model">dw.overhead.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
