<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Actual cost lines ================= -->
    <record id="dw_production_cost_line_view_list" model="ir.ui.view">
        <field name="name">dw.production.cost.line.list</field>
        <field name="model">dw.production.cost.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'approved'">
                <field name="date"/>
                <field name="cost_type"/>
                <field name="description"/>
                <field name="product_id" optional="show"/>
                <field name="quantity"/>
                <field name="uom_id" optional="hide"/>
                <field name="unit_price" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="weight_kg" sum="Weight" optional="hide"/>
                <field name="opening_id" optional="show"/>
                <field name="production_id" optional="show"/>
                <field name="workorder_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="family_id" optional="hide"/>
                <field name="is_automatic" optional="show"/>
                <field name="source_key" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dw_production_cost_line_view_form" model="ir.ui.view">
        <field name="name">dw.production.cost.line.form</field>
        <field name="model">dw.production.cost.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state == 'approved'"
                            groups="dw_manufacturing.group_dw_cost_accountant"/>
                    <button name="action_reset_to_draft" type="object" string="Reopen"
                            invisible="state != 'approved'"
                            groups="dw_manufacturing.group_dw_cost_accountant"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cost">
                            <field name="date"/>
                            <field name="cost_type"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="weight_kg"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Allocation">
                            <field name="opening_id"/>
                            <field name="production_id"/>
                            <field name="workorder_id"/>
                            <field name="sale_order_id"/>
                            <field name="project_id"/>
                            <field name="family_id"/>
                            <field name="partner_id"/>
                            <field name="analytic_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Source Documents">
                        <group>
                            <field name="is_automatic" readonly="1"/>
                            <field name="source_key" readonly="1"/>
                            <field name="stock_move_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_value_id" readonly="1"/>
                            <field name="account_move_id" readonly="1"/>
                            <field name="account_move_line_id" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revisions" name="revisions">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="old_amount"/>
                                    <field name="new_amount"/>
                                    <field name="difference"/>
                                    <field name="reason"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dw_production_cost_line_view_pivot" model="ir.ui.view">
        <field name="name">dw.production.cost.line.pivot</field>
        <field name="model">dw.production.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="Actual Cost">
                <field name="cost_type" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="dw_production_cost_line_view_graph" model="ir.ui.view">
        <field name="name">dw.production.cost.line.graph</field>
        <field name="model">dw.production.cost.line</field>
        <field name="arch" type="xml">
            <graph string="Actual Cost" type="bar">
                <field name="cost_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="dw_production_cost_line_view_search" model="ir.ui.view">
        <field name="name">dw.production.cost.line.search</field>
        <field name="model">dw.production.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="opening_id"/>
                <field name="project_id"/>
                <field name="source_key"/>
                <filter string="Automatic" name="automatic" domain="[('is_automatic', '=', True)]"/>
                <filter string="Manual" name="manual" domain="[('is_automatic', '=', False)]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="Material" name="f_material" domain="[('cost_type', '=', 'material')]"/>
                <filter string="Labour" name="f_labor" domain="[('cost_type', '=', 'labor')]"/>
                <filter string="Machine" name="f_machine" domain="[('cost_type', '=', 'machine')]"/>
                <group>
                    <filter string="Cost Type" name="group_type" context="{'group_by': 'cost_type'}"/>
                    <filter string="Manufacturing Order" name="group_mo" context="{'group_by': 'production_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Product Family" name="group_family" context="{'group_by': 'family_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dw_production_cost_line_action" model="ir.actions.act_window">
        <field name="name">Actual Cost Lines</field>
        <field name="res_model">dw.production.cost.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>

    <!-- ================= Project cost entries ================= -->
    <record id="dw_project_cost_entry_view_form" model="ir.ui.view">
        <field name="name">dw.project.cost.entry.form</field>
        <field name="model">dw.project.cost.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state in ('approved', 'cancel')"
                            groups="dw_manufacturing.group_dw_cost_accountant"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Allocation">
                            <field name="project_id"/>
                            <field name="sale_order_id"/>
                            <field name="production_id"/>
                            <field name="opening_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Expense">
                            <field name="date"/>
                            <field name="cost_type"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="reference"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dw_project_cost_entry_view_list" model="ir.ui.view">
        <field name="name">dw.project.cost.entry.list</field>
        <field name="model">dw.project.cost.entry</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="production_id" optional="show"/>
                <field name="opening_id" optional="hide"/>
                <field name="cost_type"/>
                <field name="partner_id" optional="show"/>
                <field name="quantity" optional="hide"/>
                <field name="unit_price" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dw_project_cost_entry_view_search" model="ir.ui.view">
        <field name="name">dw.project.cost.entry.search</field>
        <field name="model">dw.project.cost.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="production_id"/>
                <field name="partner_id"/>
                <filter string="To Approve" name="to_approve" domain="[('state', 'in', ('draft', 'submitted'))]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Cost Type" name="group_type" context="{'group_by': 'cost_type'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Vendor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dw_project_cost_entry_action" model="ir.actions.act_window">
        <field name="name">Project Cost Entries</field>
        <field name="res_model">dw.project.cost.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Revisions ================= -->
    <record id="dw_production_cost_revision_view_list" model="ir.ui.view">
        <field name="name">dw.production.cost.revision.list</field>
        <field name="model">dw.production.cost.revision</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="date"/>
                <field name="cost_line_id"/>
                <field name="user_id"/>
                <field name="old_amount"/>
                <field name="new_amount"/>
                <field name="difference" sum="Difference"/>
                <field name="reason"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dw_production_cost_revision_action" model="ir.actions.act_window">
        <field name="name">Cost Revisions</field>
        <field name="res_model">dw.production.cost.revision</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
