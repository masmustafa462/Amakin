<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Scrap reasons ================= -->
    <record id="dw_scrap_reason_view_list" model="ir.ui.view">
        <field name="name">dw.scrap.reason.list</field>
        <field name="model">dw.scrap.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="scrap_type"/>
                <field name="is_planned"/>
                <field name="is_reusable"/>
                <field name="requires_approval"/>
                <field name="responsible_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dw_scrap_reason_action" model="ir.actions.act_window">
        <field name="name">Scrap Reasons</field>
        <field name="res_model">dw.scrap.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= stock.scrap extension ================= -->
    <record id="stock_scrap_form_dw" model="ir.ui.view">
        <field name="name">stock.scrap.form.dw</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scrap_qty']" position="after">
                <field name="dw_reason_id"/>
                <field name="dw_is_planned"/>
                <field name="dw_is_reusable"/>
                <field name="dw_operation_type_id"/>
                <field name="dw_workcenter_id"/>
                <field name="dw_responsible_id"/>
                <field name="dw_opening_id"/>
                <field name="dw_project_id"/>
                <field name="dw_weight_kg" readonly="1"/>
                <field name="dw_value" readonly="1"/>
                <field name="dw_currency_id" invisible="1"/>
                <field name="dw_approved" readonly="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_dw_approve" type="object" string="Approve Scrap"
                        invisible="dw_approved or state == 'done'"
                        groups="dw_manufacturing.group_dw_supervisor"/>
                <button name="action_create_offcut" type="object" string="Register Off-cut"
                        invisible="state != 'done' or not dw_is_reusable"
                        groups="dw_manufacturing.group_dw_stock"/>
            </xpath>
        </field>
    </record>

    <record id="stock_scrap_list_dw" model="ir.ui.view">
        <field name="name">stock.scrap.list.dw</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="dw_reason_id" optional="show"/>
                <field name="dw_opening_id" optional="show"/>
                <field name="dw_project_id" optional="hide"/>
                <field name="dw_weight_kg" optional="show" sum="Weight"/>
                <field name="dw_value" optional="show" sum="Value"/>
                <field name="dw_currency_id" column_invisible="1"/>
            </field>
        </field>
    </record>

    <record id="dw_scrap_action" model="ir.actions.act_window">
        <field name="name">Fabrication Scrap</field>
        <field name="res_model">stock.scrap</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('dw_reason_id', '!=', False)]</field>
    </record>

    <!-- ================= Off-cuts ================= -->
    <record id="dw_material_offcut_view_form" model="ir.ui.view">
        <field name="name">dw.material.offcut.form</field>
        <field name="model">dw.material.offcut</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_return_to_stock" type="object" class="btn-primary"
                            string="Return to Stock" invisible="state != 'draft'"
                            groups="dw_manufacturing.group_dw_stock"/>
                    <button name="action_reserve" type="object" string="Reserve"
                            invisible="state != 'available'"/>
                    <button name="action_back_to_available" type="object" string="Release Reservation"
                            invisible="state != 'reserved'"/>
                    <button name="action_mark_used" type="object" string="Mark as Used"
                            invisible="state not in ('available', 'reserved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,available,reserved,used"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Material">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                            <field name="weight_kg"/>
                            <field name="cost_value"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Storage">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="barcode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Dimensions (mm)">
                        <group>
                            <field name="length_mm"/>
                            <field name="width_mm"/>
                        </group>
                        <group>
                            <field name="thickness_mm"/>
                            <field name="diameter_mm"/>
                        </group>
                    </group>
                    <group string="Origin and Use">
                        <group>
                            <field name="scrap_id"/>
                            <field name="production_id"/>
                            <field name="opening_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="used_in_production_id"/>
                            <field name="create_date_only"/>
                            <field name="last_use_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dw_material_offcut_view_list" model="ir.ui.view">
        <field name="name">dw.material.offcut.list</field>
        <field name="model">dw.material.offcut</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'"
                  decoration-muted="state in ('used', 'scrapped')">
                <field name="name"/>
                <field name="product_id"/>
                <field name="length_mm"/>
                <field name="width_mm" optional="hide"/>
                <field name="thickness_mm" optional="hide"/>
                <field name="quantity"/>
                <field name="uom_id" optional="hide"/>
                <field name="weight_kg" sum="Weight"/>
                <field name="cost_value" sum="Value" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="production_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dw_material_offcut_view_search" model="ir.ui.view">
        <field name="name">dw.material.offcut.search</field>
        <field name="model">dw.material.offcut</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="barcode"/>
                <field name="location_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Used" name="used" domain="[('state', '=', 'used')]"/>
                <group>
                    <filter string="Material" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dw_material_offcut_action" model="ir.actions.act_window">
        <field name="name">Material Off-cuts</field>
        <field name="res_model">dw.material.offcut</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>
