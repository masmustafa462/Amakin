<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dw_alert_rule_view_list" model="ir.ui.view">
        <field name="name">dw.alert.rule.list</field>
        <field name="model">dw.alert.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="alert_type"/>
                <field name="family_id"/>
                <field name="threshold"/>
                <field name="severity"/>
                <field name="notify_user_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dw_alert_rule_action" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">dw.alert.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="dw_alert_view_list" model="ir.ui.view">
        <field name="name">dw.alert.list</field>
        <field name="model">dw.alert</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="state == 'closed'">
                <field name="date"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"/>
                <field name="opening_id" optional="show"/>
                <field name="production_id" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="value" optional="show"/>
                <field name="threshold" optional="show"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
                <button name="action_acknowledge" type="object" string="Acknowledge"
                        icon="fa-check" invisible="state != 'open'"/>
                <button name="action_close" type="object" string="Close"
                        icon="fa-times" invisible="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="dw_alert_view_search" model="ir.ui.view">
        <field name="name">dw.alert.search</field>
        <field name="model">dw.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="production_id"/>
                <field name="opening_id"/>
                <field name="project_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Critical" name="critical" domain="[('severity', '=', 'critical')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'alert_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dw_alert_action" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">dw.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
