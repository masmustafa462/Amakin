        <field name="name">Project Profitability</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dw_manufacturing.dw_project_profitability_pdf</field>
        <field name="report_file">dw_manufacturing.dw_project_profitability_pdf</field>
        <field name="print_report_name">'Profitability - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
