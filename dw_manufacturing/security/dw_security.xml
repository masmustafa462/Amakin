<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Application category and privilege.
             No group or privilege name contains the '&' character, which breaks
             some user interface widgets. -->
        <record id="module_category_dw" model="ir.module.category">
            <field name="name">Metal Fabrication</field>
            <field name="sequence">35</field>
        </record>

        <record id="privilege_dw" model="res.groups.privilege">
            <field name="name">Metal Fabrication</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="module_category_dw"/>
        </record>

        <!-- Hierarchical access level.
             The XML ids group_dw_user and group_dw_manager come from phase 1 and
             are preserved so existing user assignments survive the upgrade. -->
        <record id="group_dw_user" model="res.groups">
            <field name="name">Fabrication User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_dw"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('project.group_project_user')), (4, ref('mrp.group_mrp_user'))]"/>
        </record>

        <record id="group_dw_supervisor" model="res.groups">
            <field name="name">Fabrication Supervisor</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="privilege_dw"/>
            <field name="implied_ids" eval="[(4, ref('group_dw_user'))]"/>
        </record>

        <record id="group_dw_manager" model="res.groups">
            <field name="name">Fabrication Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_dw"/>
            <field name="implied_ids" eval="[(4, ref('group_dw_supervisor')), (4, ref('sales_team.group_sale_manager')), (4, ref('project.group_project_manager')), (4, ref('mrp.group_mrp_manager'))]"/>
        </record>

        <!-- Functional roles: independent check boxes, combinable with any level. -->
        <record id="group_dw_stock" model="res.groups">
            <field name="name">Fabrication Stock Officer</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_dw_quality" model="res.groups">
            <field name="name">Fabrication Quality Officer</field>
        </record>

        <record id="group_dw_cost_accountant" model="res.groups">
            <field name="name">Fabrication Cost Accountant</field>
        </record>

        <record id="group_dw_project_manager" model="res.groups">
            <field name="name">Fabrication Project Manager</field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>

        <record id="group_dw_profitability" model="res.groups">
            <field name="name">Fabrication Profitability Access</field>
        </record>

        <!-- The manager inherits every functional role. -->
        <record id="group_dw_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_dw_stock')), (4, ref('group_dw_quality')), (4, ref('group_dw_cost_accountant')), (4, ref('group_dw_project_manager')), (4, ref('group_dw_profitability'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dw_manufacturing.group_dw_manager'))]"/>
        </record>
    </data>
</odoo>
