<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        QWeb template that backs every PDF export from the dynamic
        reports viewer (Trial Balance, Profit & Loss, Balance Sheet,
        General Ledger, Aged Receivables / Payables, Cash Flow,
        Customer Statement, Partner Ledger, Tax Summary, etc.).

        Renders one page per `r in rendered`; each `r` carries the
        report doc and the cached payload (columns + lines + meta +
        currency).

        Visual identity is delegated to the suite stylesheet at
        `eh_account_base.eh_report_styles` and the footer at
        `eh_account_base.eh_report_footer`. The paperformat sets a
        generous top margin so web.external_layout's company header
        band never collides with the report title on the first page.
    -->

    <template id="report_dynamic_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="rendered" t-as="r">
                <t t-set="company" t-value="r.get('doc').env.company"/>
                <t t-call="eh_account_base.eh_clean_layout">
                    <t t-call="eh_account_base.eh_report_styles"/>
                    <!-- RTL languages (Arabic, ...) flip the page direction so
                         the table columns, alignment and indentation mirror;
                         the eh_pdf_rtl class carries the Arabic font and the
                         letter-spacing reset (see eh_account_base styles). -->
                    <t t-set="rtl" t-value="r.get('is_rtl')"/>
                    <div t-attf-class="page eh_pdf_page #{'eh_pdf_rtl' if rtl else ''}"
                         t-att-dir="'rtl' if rtl else 'ltr'">

                        <t t-call="eh_account_base.eh_report_header">
                            <t t-set="title" t-value="r.get('doc').name"/>
                        </t>

                        <!-- Report conditions: one bordered cell per condition
                             (label above, value below) so Arabic labels and
                             Latin / numeric values never share a bidi run. -->
                        <t t-set="meta" t-value="r.get('payload').get('meta', {})"/>
                        <t t-set="md" t-value="r.get('meta_display') or {}"/>
                        <t t-set="curr" t-value="r.get('payload').get('currency') or {}"/>
                        <table class="eh_pdf_meta_grid">
                            <tr>
                                <t t-if="md.get('account_names')">
                                    <td><div class="eh_pdf_meta_label">Account:</div>
                                        <div class="eh_pdf_meta_value"><t t-out="md.get('account_names')"/></div></td>
                                </t>
                                <t t-if="md.get('partner_names')">
                                    <td><div class="eh_pdf_meta_label">Partner:</div>
                                        <div class="eh_pdf_meta_value"><t t-out="md.get('partner_names')"/></div></td>
                                </t>
                                <t t-if="meta.get('date_from') and meta.get('date_to')">
                                    <td><div class="eh_pdf_meta_label">From:</div>
                                        <div class="eh_pdf_meta_value"><t t-out="md.get('date_from')"/></div></td>
                                    <td><div class="eh_pdf_meta_label">To:</div>
                                        <div class="eh_pdf_meta_value"><t t-out="md.get('date_to')"/></div></td>
                                </t>
                                <t t-elif="meta.get('date_to')">
                                    <td><div class="eh_pdf_meta_label">As at:</div>
                                        <div class="eh_pdf_meta_value"><t t-out="md.get('date_to')"/></div></td>
                                </t>
                                <td><div class="eh_pdf_meta_label">Posted only:</div>
                                    <div class="eh_pdf_meta_value"><t t-out="md.get('posted_only')"/></div></td>
                                <t t-if="curr">
                                    <td><div class="eh_pdf_meta_label">Currency:</div>
                                        <div class="eh_pdf_meta_value">
                                            <t t-if="curr.get('multi_currency')">Multi-currency</t>
                                            <t t-else=""><t t-out="curr.get('name', '')"/><t t-if="curr.get('symbol')"> (<t t-out="curr.get('symbol')"/>)</t></t>
                                        </div></td>
                                </t>
                                <td><div class="eh_pdf_meta_label">Generated:</div>
                                    <div class="eh_pdf_meta_value"><t t-out="md.get('generated_at')"/></div></td>
                            </tr>
                        </table>

                        <table class="eh_pdf_table eh_pdf_table_fixed">
                            <colgroup>
                                <t t-foreach="r.get('col_widths') or []" t-as="w">
                                    <col t-att-style="'width: ' + str(w) + '%;'"/>
                                </t>
                            </colgroup>
                            <thead>
                                <tr>
                                    <t t-foreach="r.get('payload').get('columns') or []"
                                       t-as="col">
                                        <th t-att-class="'text-end' if col.get('figure_type') in ('monetary', 'integer', 'float', 'percentage') else ''">
                                            <t t-out="col.get('name')"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="r.get('lines') or []" t-as="line">
                                    <tr t-att-class="line.get('css_class')">
                                        <td t-att-style="'padding-%s: %sem;' % ('right' if rtl else 'left', str((line.get('level') or 0) * 1.0))">
                                            <t t-out="line.get('name')"/>
                                        </td>
                                        <t t-foreach="line.get('cells') or []" t-as="cell">
                                            <td t-att-class="'text-end' if cell.get('align_right') else ''">
                                                <t t-out="cell.get('display')"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                                <t t-if="not r.get('lines')">
                                    <tr>
                                        <td t-att-colspan="len(r.get('payload').get('columns') or []) or 1"
                                            class="text-center text-muted"
                                            style="padding: 20pt;">
                                            No data for the selected filters.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-call="eh_account_base.eh_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
