<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_custody_handover" model="ir.actions.report">
        <field name="name">نموذج تسلّم عهدة</field>
        <field name="model">employee.custody</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_custody.report_custody_handover</field>
        <field name="report_file">hr_employee_custody.report_custody_handover</field>
        <field name="binding_model_id" ref="model_employee_custody"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'تسلم عهدة - %s' % (object.name)</field>
