<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Module category                                                  -->
    <!-- ============================================================== -->
    <record id="module_category_custody" model="ir.module.category">
        <field name="name">إدارة العهد</field>
        <field name="description">تحكم صلاحيات إدارة عهد الموظفين.</field>
        <field name="sequence">20</field>
    </record>

    <!-- ============================================================== -->
    <!-- Privilege                                                        -->
    <!-- Odoo 19 replaced res.groups.category_id by res.groups.privilege_id;
         the privilege record is what groups the five tiers together on the
         user form, and it carries the ir.module.category reference.       -->
    <!-- ============================================================== -->
    <record id="res_groups_privilege_custody" model="res.groups.privilege">
        <field name="name">إدارة العهد</field>
        <field name="description">تحكم صلاحيات إدارة عهد الموظفين.</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_custody"/>
    </record>

    <!-- ============================================================== -->
    <!-- Security groups (cumulative)                                     -->
    <!-- ============================================================== -->
    <record id="group_custody_user" model="res.groups">
        <field name="name">مستخدم العهد / Custody User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="comment">ينشئ طلبات العهد الخاصة به ويقدمها للاعتماد.</field>
    </record>

    <record id="group_custody_officer" model="res.groups">
        <field name="name">مسؤول العهد / Custody Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_user'))]"/>
        <field name="comment">يعتمد طلبات العهد ويصرفها.</field>
    </record>

    <record id="group_custody_accountant" model="res.groups">
        <field name="name">محاسب العهد / Custody Accountant</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_officer'))]"/>
        <field name="comment">يُسوِّي العهد ويُرحل القيود المحاسبية.</field>
    </record>

    <record id="group_custody_manager" model="res.groups">
        <field name="name">مدير العهد / Custody Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_accountant'))]"/>
        <field name="comment">إدارة كاملة للعهد عبر الشركات.</field>
    </record>

    <record id="group_custody_admin" model="res.groups">
        <field name="name">مدير نظام العهد / Custody Admin</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_manager')), (4, ref('base.group_system'))]"/>
        <field name="comment">صلاحيات مطلقة بما فيها إعادة الحالات للمسودة.</field>
    </record>

    <!-- ============================================================== -->
    <!-- Multi-company record rules                                       -->
    <!-- ============================================================== -->
    <record id="custody_company_rule" model="ir.rule">
        <field name="name">Employee Custody: multi-company</field>
        <field name="model_id" ref="model_employee_custody"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="custody_settlement_company_rule" model="ir.rule">
        <field name="name">Custody Settlement: multi-company</field>
        <field name="model_id" ref="model_employee_custody_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="custody_line_company_rule" model="ir.rule">
        <field name="name">Custody Line: multi-company</field>
        <field name="model_id" ref="model_employee_custody_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="custody_type_company_rule" model="ir.rule">
        <field name="name">Custody Type: multi-company</field>
        <field name="model_id" ref="model_employee_custody_type"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <record id="custody_category_company_rule" model="ir.rule">
        <field name="name">Custody Category: multi-company</field>
        <field name="model_id" ref="model_employee_custody_category"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <!-- ============================================================== -->
    <!-- Self-service rule — regular users see only their custodies       -->
    <!-- ============================================================== -->
    <record id="custody_user_own_rule" model="ir.rule">
        <field name="name">Custody: users see own records</field>
        <field name="model_id" ref="model_employee_custody"/>
        <field name="domain_force">
            ['|', ('user_id', '=', user.id),
                  ('employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="custody_officer_rule" model="ir.rule">
        <field name="name">Custody: officers see their company</field>
        <field name="model_id" ref="model_employee_custody"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_custody_officer'))]"/>
    </record>

    <record id="custody_manager_rule" model="ir.rule">
        <field name="name">Custody: managers see all (allowed companies)</field>
        <field name="model_id" ref="model_employee_custody"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
    </record>

    <!-- Settlement rules mirror custody rules -->
    <record id="custody_settlement_user_own_rule" model="ir.rule">
        <field name="name">Settlement: users see own</field>
        <field name="model_id" ref="model_employee_custody_settlement"/>
        <field name="domain_force">
            ['|', ('custody_id.user_id', '=', user.id),
                  ('custody_id.employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="custody_settlement_officer_rule" model="ir.rule">
        <field name="name">Settlement: officers/accountants</field>
        <field name="model_id" ref="model_employee_custody_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_custody_officer')), (4, ref('group_custody_accountant'))]"/>
    </record>

</odoo>
