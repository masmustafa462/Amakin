<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_custody_line_tree" model="ir.ui.view">
        <field name="name">employee.custody.line.tree</field>
        <field name="model">employee.custody.line</field>
        <field name="arch" type="xml">
            <list string="تفاصيل العهدة">
                <field name="custody_id"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
