<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_custody_type_tree" model="ir.ui.view">
        <field name="name">employee.custody.type.tree</field>
        <field name="model">employee.custody.type</field>
        <field name="arch" type="xml">
            <list string="أنواع العهد">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="custody_kind"/>
                <field name="category_id"/>
                <field name="default_duration_days"/>
                <field name="require_approval"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_custody_type_form" model="ir.ui.view">
        <field name="name">employee.custody.type.form</field>
        <field name="model">employee.custody.type</field>
        <field name="arch" type="xml">
            <form string="نوع العهدة">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="custody_kind" widget="radio"/>
                            <field name="category_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="default_duration_days"/>
                            <field name="require_approval"/>
                            <field name="require_hr_approval"/>
                            <field name="require_accounting_approval"/>
                            <field name="allow_partial_return" invisible="custody_kind != 'material'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="التوجيه المحاسبي" invisible="custody_kind != 'financial'">
                            <group>
                                <group>
                                    <field name="journal_id"/>
                                    <field name="custody_account_id"/>
                                    <field name="cash_account_id"/>
                                </group>
                                <group>
                                    <field name="expense_account_id"/>
                                    <field name="salary_deduction_account_id"/>
                                    <field name="loss_account_id"/>
                                    <field name="employee_due_account_id"/>
                                    <field name="analytic_account_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="الوصف">
                            <field name="description" placeholder="الوصف التفصيلي..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custody_type" model="ir.actions.act_window">
        <field name="name">أنواع العهد</field>
        <field name="res_model">employee.custody.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
