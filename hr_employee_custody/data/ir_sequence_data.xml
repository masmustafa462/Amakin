<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_employee_custody" model="ir.sequence">
        <field name="name">Employee Custody</field>
        <field name="code">employee.custody</field>
        <field name="prefix">CUST/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_employee_custody_settlement" model="ir.sequence">
        <field name="name">Custody Settlement</field>
        <field name="code">employee.custody.settlement</field>
        <field name="prefix">STL/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
