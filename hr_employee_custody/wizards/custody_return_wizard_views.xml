<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_custody_return_wizard_form" model="ir.ui.view">
        <field name="name">custody.return.wizard.form</field>
        <field name="model">custody.return.wizard</field>
        <field name="arch" type="xml">
            <form string="إرجاع عهدة عينية">
                <sheet>
                    <group>
                        <field name="custody_id"/>
                        <field name="return_date"/>
                        <field name="remaining_quantity"/>
                        <field name="returned_quantity"/>
                        <field name="return_condition"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="تأكيد الإرجاع" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_custody_return_wizard" model="ir.actions.act_window">
        <field name="name">إرجاع عهدة عينية</field>
        <field name="res_model">custody.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
